{
  "name": "eaglet-vpn",
  "productName": "Eaglet",
  "version": "0.1.0",
  "description": "Eaglet — fast, private, electric. A desktop VPN client with six swappable interface styles.",
  "main": "./out/main/index.js",
  "author": "Eaglet",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "map": "node scripts/gen-map.mjs",
    "shots": "electron-vite build && electron scripts/screenshots.cjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "topojson-client": "^3.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "world-atlas": "^2.0.2"
  }
}
