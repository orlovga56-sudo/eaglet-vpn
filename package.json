{
  "name": "eaglet-vpn",
  "productName": "Eaglet",
  "version": "0.1.0",
  "description": "Eaglet — fast, private, electric. A desktop VPN client with six swappable interface styles.",
  "main": "./out/main/index.js",
  "author": "Eaglet",
  "license": "MIT",
  "private": true,
  "build": {
    "appId": "com.eaglet.vpn",
    "productName": "Eaglet",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network"
    }
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "map": "node scripts/gen-map.mjs",
    "core": "node scripts/fetch-core.mjs",
    "shots": "electron-vite build && node scripts/screenshots.cjs"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "topojson-client": "^3.1.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "world-atlas": "^2.0.2"
  }
}
